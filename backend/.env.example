# SkillCompass Backend Environment Variables

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# AI & LLM Providers (Optional - fallback to deterministic mode if unset)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
EMBEDDING_PROVIDER=local_deterministic

# Context-Aware Reassessment Engine & RAG Configuration
MATERIALS_TO_REASSESS_THRESHOLD=3
WEAK_TOPIC_ACCURACY_THRESHOLD=0.60
RAG_TOP_K_CHUNKS=5
REASSESS_QUESTION_COUNT=5
DYNAMIC_REASSESSMENT_ENABLED=true

# Server Runtime Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
