# SkillCompass Backend Environment Variables

# Database: PostgreSQL / Supabase connection string

DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.xxxxxx.supabase.co:5432/postgres

# AI Service: OpenAI API Key (for RAG question generator and embeddings)

OPENAI_API_KEY=sk-proj-your-actual-api-key-here

# Environment & Server Config


ENVIRONMENT=development
PORT=8000